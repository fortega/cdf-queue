{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pytest all",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-s"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Pytest current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-s", "${relativeFile}"],
            "cwd": "${workspaceFolder}"
        }
    ]
}